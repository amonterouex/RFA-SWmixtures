Cell[BoxData[
 RowBox[{
  RowBox[{"EulerILT", "[", 
   RowBox[{"funs_", ",", "t_", ",", "argu_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"aa", "=", "19.1"}], ",", 
      RowBox[{"ntr", "=", "15"}], ",", 
      RowBox[{"mEuler", "=", "11"}], ",", " ", "\[IndentingNewLine]", 
      RowBox[{"hh", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Pi", "/", "t"}], "]"}]}], ",", "suma", ",", 
      RowBox[{"avgsu", "=", "0."}], ",", "c", ",", "xx", ",", "su", ",", "uu",
       ",", "nn"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"c", "[", "m_", "]"}], ":=", 
      RowBox[{
       RowBox[{"c", "[", "m", "]"}], "=", 
       RowBox[{"Binomial", "[", 
        RowBox[{"mEuler", ",", 
         RowBox[{"m", "-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"aa", "/", "2."}], "]"}], "/", "t"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"xx", "=", 
      RowBox[{"aa", "/", 
       RowBox[{"(", 
        RowBox[{"2.", "*", "t"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"su", "[", "1", "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Re", "[", " ", 
         RowBox[{"funs", "[", 
          RowBox[{"xx", ",", "argu"}], "]"}], " ", "]"}], "/", "2."}], "+", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", "nn"}], "*", 
          RowBox[{"Re", "[", 
           RowBox[{"funs", "[", 
            RowBox[{
             RowBox[{"xx", "+", 
              RowBox[{"I", "*", "nn", "*", "hh"}]}], ",", "argu"}], "]"}], 
           "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"nn", ",", "1", ",", "ntr"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"nn", "=", 
         RowBox[{"ntr", "+", "k"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"su", "[", 
          RowBox[{"k", "+", "1"}], "]"}], "=", " ", 
         RowBox[{
          RowBox[{"su", "[", "k", "]"}], "+", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", "nn"}], "*", 
           RowBox[{"Re", "[", 
            RowBox[{"funs", "[", 
             RowBox[{
              RowBox[{"xx", "+", 
               RowBox[{"I", "*", "nn", "*", "hh"}]}], ",", "argu"}], "]"}], 
            "]"}]}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", 
         RowBox[{"mEuler", "+", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"avgsu", "=", " ", 
        RowBox[{"avgsu", "+", 
         RowBox[{
          RowBox[{"c", "[", "j", "]"}], "*", 
          RowBox[{"su", "[", "j", "]"}]}]}]}], " ", ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"mEuler", "+", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", " ", 
     RowBox[{"uu", "*", 
      RowBox[{"avgsu", "/", 
       RowBox[{"2", "^", "mEuler"}]}]}]}]}], " ", "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.889708546153808*^9, 3.889708570521411*^9}, {
