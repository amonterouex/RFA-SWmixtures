Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ",", 
     RowBox[{"j", "=", "1"}], ",", 
     RowBox[{"qmax", "=", "50"}], ",", 
     RowBox[{"Deltaq", "=", "0.1"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"hqExample", "[", 
      RowBox[{"i", ",", "j"}], "]"}], "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q", ",", 
         RowBox[{"htilde", "[", 
          RowBox[{"q", ",", "i", ",", "j"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"q", ",", 
         RowBox[{"sig", "[", 
          RowBox[{"i", ",", "j"}], "]"}], ",", "qmax", ",", "Deltaq"}], 
        "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ListPlot", "[", 
     RowBox[{
      RowBox[{"hqExample", "[", 
       RowBox[{"i", ",", "j"}], "]"}], ",", 
      RowBox[{"AspectRatio", "->", "1"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
