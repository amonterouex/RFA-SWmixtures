Cell[TextData[{
 StyleBox["EulerILTplus",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->GrayLevel[0]],
 StyleBox[" is a slower but more accurate version of ",
  FontSize->14,
  FontColor->GrayLevel[0]],
 StyleBox["EulerILT",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->GrayLevel[0]]
}], "Text",
