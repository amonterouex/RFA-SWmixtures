Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"i", "=", "3"}], ",", 
     RowBox[{"j", "=", "3"}], ",", 
     RowBox[{"rmax", "=", "5"}], ",", 
     RowBox[{"Deltar", "=", "0.01"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gExample", "[", 
      RowBox[{"i", ",", "j"}], "]"}], "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"g", "[", 
