Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ",", 
     RowBox[{"j", "=", "2"}], ",", 
     RowBox[{"rmax", "=", "5"}], ",", 
     RowBox[{"Deltar", "=", "0.01"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"yExample", "[", 
      RowBox[{"i", ",", "j"}], "]"}], "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"y", "[", 
          RowBox[{"r", ",", "i", ",", "j"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"sig", "[", 
          RowBox[{"i", ",", "j"}], "]"}], ",", "rmax", ",", "Deltar"}], 
        "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ListPlot", "[", 
     RowBox[{
