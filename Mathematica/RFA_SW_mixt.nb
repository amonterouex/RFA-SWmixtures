Cell[CellGroupData[{

Cell[TextData[{
 "An instruction that leads to a  more accurate, but slower, evaluation of  \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "ij"], TraditionalForm]],ExpressionUUID->
  "115fc2a5-0b94-714e-973c-97ba4e90cfe4"],
 "(r) and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "ij"], TraditionalForm]],ExpressionUUID->
  "1d259eed-6c30-8145-b6c5-a40e5a102111"],
 "(r) "
}], "Section",
 CellChangeTimes->{{3.9987734904416275`*^9, 3.9987734923801975`*^9}, {
   3.998773532854513*^9, 3.9987735505989017`*^9}, 3.9987743680048122`*^9, {
   3.998995550916397*^9, 3.998995586442848*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"78b03712-028f-a04b-8dbe-5f8ae7cf0583"],

Cell[TextData[{
 "If, for any reason, you need to verify a value  of  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "ij"], TraditionalForm]],ExpressionUUID->
  "8611be76-aa6a-a741-bb34-197f929180c7"],
 "(r) (or ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "ij"], TraditionalForm]],ExpressionUUID->
  "4d1c974e-9609-9044-a876-3bf7388c25f0"],
 "(r), of course), or you suspect that numerical precision may be an issue in \
the numerical inversion of the Laplace transform used to obtain ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "ij"], TraditionalForm]],ExpressionUUID->
  "e0158568-b903-8e4f-855f-9cd38943368e"],
 "(r), simply use the following instruction: ",
 StyleBox[" ",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.9987727006756096`*^9, 3.9987729520714455`*^9}, {
  3.998773026385271*^9, 3.998773039939108*^9}, {3.998773075904785*^9, 
  3.9987732298576927`*^9}, {3.998776797974043*^9, 3.9987768550337257`*^9}, {
  3.9989956851311417`*^9, 3.9989956882050457`*^9}, {3.998995759106844*^9, 
  3.9989958019229584`*^9}},ExpressionUUID->"82ce54f3-215c-da40-93b9-\
a74e5993811f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Inverse", " ", "Laplace", " ", "transform", " ", "of", " ", 
     SubsuperscriptBox["G", "ij", "0"], 
     RowBox[{"(", "s", ")"}]}], ":", " ", 
    RowBox[{
     SubsuperscriptBox["g", "ij", "0"], 
     RowBox[{"(", "r", ")"}], " ", "by", " ", "means", " ", "of", " ", "the", 
     " ", "EulerILTplus", " ", "algorithm"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"g0Asymm", "[", 
    RowBox[{"r_", ",", "i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"r", "<", 
      RowBox[{"sig", "[", 
       RowBox[{"i", ",", "j"}], "]"}]}], ",", "0", ",", 
     RowBox[{"r", "<=", 
      RowBox[{"\[Lambda]", "[", 
       RowBox[{"i", ",", "j"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"xiFINAL", "[", 
       RowBox[{
        RowBox[{"r", "-", 
         RowBox[{"sig", "[", 
          RowBox[{"i", ",", "j"}], "]"}]}], ",", "i", ",", "j"}], "]"}], "/", 
      "r"}], ",", 
     RowBox[{"r", "<=", 
      RowBox[{
       RowBox[{"sig", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "+", "sigmaMin"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"xiFINAL", "[", 
        RowBox[{
         RowBox[{"r", "-", 
          RowBox[{"sig", "[", 
           RowBox[{"i", ",", "j"}], "]"}]}], ",", "i", ",", "j"}], "]"}], "/",
        "r"}], "+", 
      RowBox[{
       RowBox[{"xibFINAL", "[", 
        RowBox[{
         RowBox[{"r", "-", 
          RowBox[{"\[Lambda]", "[", 
           RowBox[{"i", ",", "j"}], "]"}]}], ",", "i", ",", "j"}], "]"}], "/",
        "r"}]}], ",", 
     RowBox[{"r", ">", 
      RowBox[{
       RowBox[{"sig", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "+", "sigmaMin"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"EulerILTplus", "[", 
        RowBox[{"myfun1", ",", " ", 
         RowBox[{"r", "-", 
          RowBox[{"sig", "[", 
           RowBox[{"i", ",", "j"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}]}], "]"}], "/", "r"}], "+", 
      RowBox[{
       RowBox[{"EulerILTplus", "[", 
        RowBox[{"myfun2", ",", " ", 
         RowBox[{"r", "-", 
          RowBox[{"\[Lambda]", "[", 
           RowBox[{"i", ",", "j"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}]}], "]"}], "/", "r"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.960442192374058*^9, 3.960442315812065*^9}, {
   3.9604424297247257`*^9, 3.960442469380253*^9}, 3.960442534276905*^9, {
   3.9604426810276165`*^9, 3.960442692723236*^9}, {3.9604427275119877`*^9, 
   3.9604427423388824`*^9}, {3.960443671707098*^9, 3.9604436957136917`*^9}, 
   3.9604458064720116`*^9, {3.9604459483616104`*^9, 3.960445973611065*^9}, {
   3.9604460169156094`*^9, 3.960446064048317*^9}, {3.960446166048107*^9, 
   3.9604461670322475`*^9}, {3.960446233744915*^9, 3.960446245836075*^9}, {
   3.960447007292158*^9, 3.960447010822363*^9}, {3.9604474843731327`*^9, 
   3.9604475179353848`*^9}, 3.960462823335062*^9, 3.979831830728079*^9, 
   3.9803476699435463`*^9, 3.994325473292118*^9, {3.9943281237384777`*^9, 
   3.9943281391002445`*^9}, {3.995275302145138*^9, 3.9952753090805435`*^9}, {
   3.997546075620365*^9, 3.9975460844668217`*^9}, {3.9977044317245464`*^9, 
   3.997704438084244*^9}, {3.997704530724266*^9, 3.9977045376872387`*^9}, {
   3.997766136914858*^9, 3.997766185800873*^9}, {3.997770149609806*^9, 
   3.9977701601841965`*^9}, {3.9977832278070107`*^9, 3.997783345807167*^9}, {
   3.997783378847191*^9, 3.9977833808471146`*^9}, {3.9977835107474823`*^9, 
   3.9977835540072823`*^9}, {3.9977836103672886`*^9, 
   3.9977836283374805`*^9}, {3.998103139405081*^9, 3.998103149441988*^9}, {
   3.9987484523316364`*^9, 3.9987484689564037`*^9}, {3.998748499364107*^9, 
   3.9987485159209747`*^9}, {3.9987726263570595`*^9, 3.998772680030794*^9}, {
   3.9987733049596024`*^9, 3.998773308575983*^9}, {3.9990577864719734`*^9, 
   3.9990577882303314`*^9}},
 Background->None,
 CellLabel->"In[77]:=",ExpressionUUID->"4bfcad58-c5b6-024c-9c79-f6a0b769b8c8"],

Cell["\<\
This instruction employs the routine EulerILTplus, which is somewhat more \
precise than EulerILT but also slower. The difference between the results \
obtained with the two routines is generally very small.  An example  of this  \
is given next.\
\>", "Text",
 CellChangeTimes->{{3.9987727006756096`*^9, 3.9987729520714455`*^9}, {
   3.998773026385271*^9, 3.998773039939108*^9}, {3.998773075904785*^9, 
   3.9987732298576927`*^9}, {3.998776797974043*^9, 3.9987768550337257`*^9}, {
   3.998995623466385*^9, 3.998995677982647*^9}, 3.998995809572563*^9, {
   3.998995846490965*^9, 3.998996063365576*^9}, 
   3.9989962713937473`*^9},ExpressionUUID->"35af8292-7e16-b343-9c65-\
a4b06f35efce"],

Cell[CellGroupData[{

Cell["An example", "Subsubsection",
 CellChangeTimes->{{3.9987743180883484`*^9, 
  3.9987743384931736`*^9}},ExpressionUUID->"ca2c6fa2-66f3-3b4b-a1df-\
c1d8b1a2764b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Inverse", " ", "Laplace", " ", "transform", " ", "of", " ", 
     SubsuperscriptBox["G", "ij", "0"], 
     RowBox[{"(", "s", ")"}]}], ":", " ", 
    RowBox[{
     SubsuperscriptBox["g", "ij", "0"], 
     RowBox[{"(", "r", ")"}], " ", "by", " ", "means", " ", "of", " ", "the", 
     " ", 
     StyleBox["EulerILTplus",
      FontWeight->"Bold"], " ", "algorithm"}]}], " ", "*)"}], " ", 
