  FormBox[
   RowBox[{"r", "=", 
    SubscriptBox["\[Sigma]", "12"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e38a7b6b-a01c-3244-b969-9d3c03a5321e"],
 " up to r=rmax  in steps of size Deltar"
}], "Text",
