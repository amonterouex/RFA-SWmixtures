      RowBox[{"Joined", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<q\>\"", ",", 
         RowBox[{"Subscript", "[", 
          RowBox[{
