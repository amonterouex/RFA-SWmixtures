Cell[BoxData[
 RowBox[{
  RowBox[{"EulerILTplus", "[", 
   RowBox[{"funs_", ",", "t_", ",", "argu_List", ",", 
    RowBox[{"preci_", ":", "$MachinePrecision"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"aa", "=", "30"}], ",", 
      RowBox[{"ntr", "=", "100"}], ",", 
      RowBox[{"mEuler", "=", "30"}], ",", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"new", " ", "values", " ", "for", "  ", "A"}], "=", "aa"}], ",",
         " ", 
        RowBox[{"n", "=", 
         RowBox[{
          RowBox[{"ntr", " ", "and", " ", "m"}], "=", "mEuler"}]}]}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"hh", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Pi", "/", "t"}], ",", "preci"}], "]"}]}], ",", 
      RowBox[{"avgsu", "=", "0"}], ",", "c", ",", "xx", ",", "su", ",", "uu", 
      ",", "nn"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"c", "[", "m_", "]"}], ":=", 
      RowBox[{
       RowBox[{"c", "[", "m", "]"}], "=", 
       RowBox[{"Binomial", "[", 
        RowBox[{"mEuler", ",", 
         RowBox[{"m", "-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"aa", "/", "2"}], "]"}], "/", "t"}], ",", "preci"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"xx", "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"aa", "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "t"}], ")"}]}], ",", "preci"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"su", "[", "1", "]"}], "=", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"funs", "[", 
            RowBox[{"xx", ",", "argu"}], "]"}], "/", "2"}], ",", "preci"}], 
         "]"}], "]"}], "+", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", "nn"}], "*", 
          RowBox[{"Re", "[", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"funs", "[", 
              RowBox[{
               RowBox[{"xx", "+", 
                RowBox[{"I", "*", "nn", "*", "hh"}]}], ",", "argu"}], "]"}], ",",
              "preci"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"nn", ",", "1", ",", "ntr"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"nn", "=", 
         RowBox[{"ntr", "+", "k"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"su", "[", 
          RowBox[{"k", "+", "1"}], "]"}], "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"su", "[", "k", "]"}], "+", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], "^", "nn"}], "*", 
             RowBox[{"Re", "[", 
              RowBox[{"N", "[", 
               RowBox[{
                RowBox[{"funs", "[", 
                 RowBox[{
                  RowBox[{"xx", "+", 
                   RowBox[{"I", "*", "nn", "*", "hh"}]}], ",", "argu"}], 
                 "]"}], ",", "preci"}], "]"}], "]"}]}]}], ",", "preci"}], 
          "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", 
         RowBox[{"mEuler", "+", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"avgsu", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"avgsu", "+", 
           RowBox[{
            RowBox[{"c", "[", "j", "]"}], "*", 
            RowBox[{"su", "[", "j", "]"}]}]}], ",", "preci"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"mEuler", "+", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"uu", "*", 
        RowBox[{"avgsu", "/", 
         RowBox[{"2", "^", "mEuler"}]}]}], ",", "preci"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.889708546153808*^9, 3.889708570521411*^9}, {
