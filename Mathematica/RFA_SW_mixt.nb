Cell[CellGroupData[{
Cell[TextData[StyleBox["RFA for Square-Well, Square-Shoulder, and Nonadditive \
Hard-Sphere Mixtures", "Title"]], "Title",ExpressionUUID->"f1b616f3-77a3-1340-\
b8e1-0c5376a80bf9"],

Cell["\<\
Annotated implementation accompanying the paper. This notebook is intended as \
a transparent research implementation rather than a software package.\
\>", "Text",ExpressionUUID->"d880d41b-782a-1441-b392-cf6cd86b2049"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["How to use this notebook", "Section"]], "Section",ExpressionUUID->"af9c811d-4a7c-494a-9cf3-ca6d0c38e5a2"],

Cell[TextData[{
 "1. Evaluate the initialization cells from the beginning in a fresh \
Mathematica kernel.\n2. Modify only the parameters in the clearly marked \
case-study section.\n3. Run the coefficient-determination section before \
evaluating correlation functions.\n\nThe implementation follows the notation \
of the paper and is formulated for multicomponent mixtures with arbitrary \
compositions and core diameters. However, a common shell width, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "ij"], TraditionalForm]],ExpressionUUID->
  "456ba778-bc6b-d145-b391-d9f8ba8a120f"],
 "=\[CapitalDelta], is assumed."
}], "Text",
 CellChangeTimes->{{3.9976820739518833`*^9, 3.9976820756015205`*^9}, {
  3.9976823136418743`*^9, 3.9976823696637897`*^9}, {3.99768253798938*^9, 
