Cell[BoxData[{
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", "n", "]"}], "=", 
      RowBox[{"xcon", "[", 
       RowBox[{"[", "n", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sig", "[", 
       RowBox[{"n", ",", "n"}], "]"}], "=", 
      RowBox[{"sigmas", "[", 
       RowBox[{"[", "n", "]"}], "]"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", "nco"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sig", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "2"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"sig", "[", 
        RowBox[{"i", ",", "i"}], "]"}], "+", 
       RowBox[{"sig", "[", 
        RowBox[{"j", ",", "j"}], "]"}]}], ")"}]}], "/;", 
    RowBox[{"i", "!=", "j"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"sig", "[", 
     RowBox[{"i", ",", "j"}], "]"}], "+", "Delta"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Epsilon]", "[", 
   RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"eps", "[", 
   RowBox[{"[", 
    RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], "Input",
